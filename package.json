{
  "name": "pineanddandy-webapp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch backend/server.ts",
    "dev:web": "react-router dev",
    "start": "node --env-file-if-exists=.env backend/server.ts",
    "db:migrate": "node --env-file-if-exists=.env backend/migrate.ts",
    "test": "node --test backend/app.test.ts",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "^8.5.0",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "pg-mem": "^3.0.5",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}